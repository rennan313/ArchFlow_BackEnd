# ── Database (MongoDB via Prisma) ──────────────────────────────────────────────
# Local dev:
DATABASE_URL="mongodb://localhost:27017/ArchFlowDb"
# Production (MongoDB Atlas) — never commit a real connection string here.
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>"

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET="<generate-a-strong-random-secret>"
JWT_REFRESH_SECRET="<generate-a-different-strong-random-secret>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Auth — token expirations ────────────────────────────────────────────────────
RESET_PASSWORD_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=1440

# ── Google OAuth (optional — enables Google ID-token verification) ────────────
GOOGLE_CLIENT_ID="<google-client-id>"

# ── URLs (required in production — no localhost fallback survives; the app
# fails at boot/build if these are missing when NODE_ENV=production) ───────────
# Public URL of this API itself (metadata). Dev falls back to
# http://localhost:3000 automatically if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public URL of the frontend app — used to build links sent in emails (verification,
# password reset) and as the CORS allowed origin (next.config.ts).
# Set this to the production frontend URL when deploying (e.g. "https://app.archflow.com.br").
# Dev falls back to http://localhost:3001 automatically if unset.
FRONTEND_URL="http://localhost:3001"

# ── Supabase (required — auth JWT verification + storage) ─────────────────────
# Project Settings → API → Project URL
SUPABASE_URL="https://<ref>.supabase.co"
# Project Settings → API → service_role (secret — server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
SUPABASE_STORAGE_BUCKET="proposal-media"

# ── AI ───────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="<anthropic-api-key>"

# ── SMTP (optional — required for password-reset/verification emails to send) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ArchFlow <noreply@archflow.com.br>"
# Internal inbox that receives "schedule a demo" lead notifications from the
# public pricing page. Falls back to SMTP_FROM if unset.
SALES_EMAIL=""

# ── Rate limiting (Upstash Redis) — required in production; a single dev
# instance falls back to in-memory automatically if unset (see
# src/middlewares/rateLimiter.ts). Without this in production, the rate
# limiter silently becomes single-instance-only across a multi-instance
# deploy — that's exactly the failure mode this variable being "required in
# production" is meant to catch at boot instead of leaving to chance. ───────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Observability (optional — inert with no DSN, zero runtime cost) ───────────
SENTRY_DSN=""
# Optional manual override — auto-detected from Railway's RAILWAY_GIT_COMMIT_SHA
# if unset, so you normally don't need to set this yourself.
SENTRY_RELEASE=""

# ── Runtime ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
