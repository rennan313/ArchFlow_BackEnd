generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Plan {
  STARTER
  PROFESSIONAL
  STUDIO
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  ARCHITECT
  DESIGNER
  ASSISTANT
  VIEWER
}

enum ProposalStatus {
  DRAFT
  REVIEW
  SENT
  NEGOTIATION
  APPROVED
  REJECTED
}

// Visual treatment for a proposal/template — schema field exists ahead of the
// rendering work; only one stylesheet renders today (see plan Phase 2/5).
enum ProposalSkin {
  EDITORIAL
  MINIMAL
  PREMIUM
  CORPORATE
  LUXURY
  // Fase 2.1 — enterprise design pass. Additive: the 5 above keep working
  // (existing ProposalTemplate rows and the advisor's recommendSkin() still
  // emit them), these 4 are new, explicitly-named enterprise treatments
  // available for future template/advisor wiring without touching the
  // renderer again.
  ENTERPRISE_LIGHT
  ENTERPRISE_DARK
  PREMIUM_GOLD
  CORPORATE_EXECUTIVE
}

enum ProposalBuilderStatus {
  DRAFT
  BUILDING
  READY
  GENERATED
  ARCHIVED
}

enum ClientStatus {
  LEAD
  NEGOTIATION
  ACTIVE
  INACTIVE
}

enum MeetingStatus {
  NOT_SCHEDULED
  SCHEDULED
  COMPLETED
}

enum MeetingType {
  IN_PERSON
  PHONE_CALL
  GOOGLE_MEET
}

enum OpportunityStage {
  LEAD
  FIRST_CONTACT
  BRIEFING
  PROPOSAL_DRAFT // legacy stage, kept for existing data — Kanban groups it visually under BRIEFING
  PROPOSAL_SENT
  NEGOTIATION
  APPROVED
  LOST
}

// ─── Fase 5: Automações ─────────────────────────────────────────────────────
// Pure business-rule automations — no LLM/AI involved anywhere in this domain.

enum RecordSource {
  MANUAL
  AUTOMATION
}

enum AutomationKey {
  AUTO_CREATE_PROJECT_ON_APPROVED
  TASK_PRELIMINARY_DESIGN
  TASK_EXECUTIVE_DESIGN
  TASK_COMPATIBILIZATION
  TASK_APPROVAL
  PROJECT_OVERDUE_ALERT
  PROPOSAL_STALE_FOLLOWUP
  MEETING_AGENDA_SYNC
  CLIENT_TIMELINE_INIT
  POST_DELIVERY_FOLLOWUP
}

enum AutomationResultType {
  PROJECT_CREATED
  TASK_CREATED
  FOLLOWUP_CREATED
  ALERT_GENERATED
  TIMELINE_INITIALIZED
  NOOP
}

enum TaskStatus {
  PENDING
  DONE
}

enum ProjectPhase {
  BRIEFING
  PRELIMINARY_DESIGN
  EXECUTIVE_DESIGN
  COMPATIBILIZATION
  APPROVAL
  DELIVERY
}

enum PricingMethod {
  HOURLY
  SQUARE_METER
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
  PREMIUM
}

enum DocumentType {
  PDF
  JPG
  PNG
  DWG
  DOCX
}

enum MediaType {
  IMAGE
  GIF
  VIDEO
  YOUTUBE
  VIMEO
}

enum ProjectStatus {
  BRIEFING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum MeetingEntryStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingPurpose {
  INITIAL_CONTACT
  DISCOVERY
  BRIEFING
  PROPOSAL_REVIEW
  FOLLOW_UP
  OTHER
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
  INTERIOR
  URBAN
  LANDSCAPE
}

enum InstanceStatus {
  RUNNING
  STOPPED
  PENDING
  ERROR
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  // Sprint 09: gateway-driven pause (Mercado Pago preapproval "paused"). Access
  // is limited (read-only writes) but the subscription is not terminated — a
  // resumed preapproval flips it back to ACTIVE without a new checkout.
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// ─── Financial Domain ─────────────────────────────────────────────────────────
// Tenant-office bookkeeping (the architecture office's own AP/AR) — distinct
// bounded context from Subscription/BillingPlan/PaymentEvent/BillingHistory
// above, which is ArchFlow charging the workspace for its SaaS plan. Never
// reuse those models for office-level supplier/client money.

enum BankAccountType {
  CHECKING
  SAVINGS
}

enum FinancialDirection {
  PAYABLE
  RECEIVABLE
}

// OVERDUE is intentionally not a stored state — there is no scheduled-job
// infra in this backend to sweep and transition it. "Vencida" is derived at
// query time (dueDate < now && status != PAID) wherever needed (KPIs, lists).
enum InstallmentStatus {
  OPEN
  PARTIAL
  PAID
}

enum PaymentMethod {
  PIX
  BOLETO
  TRANSFER
  CASH
  CARD
}

// ─── Core Domain Models ───────────────────────────────────────────────────────

model Workspace {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  slug   String  @unique
  plan   Plan    @default(STARTER)
  active Boolean @default(true)

  // Dashboard widget order/visibility, shared by the whole workspace.
  // Stored as a JSON string — see generatedProposalJson for the same
  // string-not-Json convention used elsewhere in this schema.
  // Shape: {"order": string[], "hidden": string[]}
  dashboardLayout String?

  // Worklog Sprint V2, MEL-01 — IANA zone name (e.g. "America/Sao_Paulo"),
  // validated against Intl.supportedValuesOf("timeZone") in
  // validations/workspace.ts. Null until an OWNER/ADMIN sets one explicitly
  // (update:workspace) — TimeEntry timestamps are always stored in UTC
  // regardless; this only decides which calendar day/week a given instant
  // displays under and how worklogSummary.service.ts buckets weekly totals.
  // Frontend falls back to the browser's resolved timezone while this is
  // null (WORKLOG_ARCHITECTURE_DECISIONS.md, Sprint V2 addendum).
  timezone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  invites         WorkspaceInvite[]
  clients         Client[]
  opportunities   Opportunity[]
  proposals       Proposal[]
  projects        Project[]
  meetings        Meeting[]
  automations     Automation[]
  automationRuns  AutomationRun[]
  tasks           Task[]
  followUps       FollowUp[]
  branding        OfficeBranding?
  subscription    Subscription?
  documents       Document[]
  documentFolders DocumentFolder[]

  proposalTemplates  ProposalTemplate[]
  proposalSections   ProposalSection[]
  proposalBlocks     ProposalBlock[]
  proposalNarratives ProposalNarrative[]

  supplierCategories  SupplierCategory[]
  suppliers           Supplier[]
  bankAccounts        BankAccount[]
  financialCategories FinancialCategory[]
  costCenters         CostCenter[]
  financialDocuments  FinancialDocument[]
  purchaseOrders      PurchaseOrder[]

  timeEntries        TimeEntry[]
  activityCategories ActivityCategory[]

  @@map("workspaces")
}

model WorkspaceInvite {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String        @db.ObjectId
  email       String
  role        WorkspaceRole @default(ARCHITECT)
  token       String        @unique
  expiresAt   DateTime
  accepted    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([workspaceId, accepted])
  @@map("workspace_invites")
}

model User {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  supabaseId    String? // Supabase auth.users UUID — null for pre-migration users
  // IMPORTANT: uniqueness enforced by a MongoDB sparse index (see docs/indexes.md)
  // Prisma's @unique creates a non-sparse index that rejects multiple nulls.
  name          String
  email         String        @unique
  password      String? // Transitional: kept during Phase 1 for NextAuth credentials; removed in Phase 2
  emailVerified DateTime? // null = unverified; set when the user confirms their email
  image         String?
  provider      String        @default("credentials")
  googleId      String?
  role          Role          @default(USER)
  workspaceId   String?       @db.ObjectId
  workspaceRole WorkspaceRole @default(OWNER)
  lastLogin     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals        Proposal[]
  clients          Client[]
  opportunities    Opportunity[]
  projects         Project[]
  meetings         Meeting[]
  followUps        FollowUp[]
  assignedTasks    Task[]
  branding         OfficeBranding?
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  documents        Document[]
  documentVersions DocumentVersion[]
  documentFolders  DocumentFolder[]

  proposalTemplates  ProposalTemplate[]
  proposalSections   ProposalSection[]
  proposalBlocks     ProposalBlock[]
  proposalNarratives ProposalNarrative[]

  financialDocumentsCreated FinancialDocument[]
  paymentsCreated           Payment[]
  purchaseOrdersCreated     PurchaseOrder[]

  timeEntries TimeEntry[]

  @@index([workspaceId])
  @@map("users")
}

model OfficeBranding {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @unique @db.ObjectId
  workspaceId String? @unique @db.ObjectId

  // Office identity
  officeName    String?
  tradeName     String?
  architectName String?
  cauNumber     String?

  // Contact
  email     String?
  phone     String?
  whatsapp  String?
  website   String?
  instagram String?

  // Brand colors (hex)
  primaryColor   String?
  secondaryColor String?

  // Assets — URLs (public or signed) + storage paths for refresh
  logoUrl              String?
  logoStoragePath      String?
  logoWhiteUrl         String?
  logoWhiteStoragePath String?
  faviconUrl           String?
  faviconStoragePath   String?

  // Proposal customization
  proposalSignature String?
  proposalFooter    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@map("office_branding")
}

model Client {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  // Basic information
  name    String
  email   String?
  phone   String?
  company String?
  address String?
  city    String?
  state   String?
  notes   String?

  // Pipeline status
  status ClientStatus @default(LEAD)

  // First contact — meeting information
  // meetingSummary is designed to feed AI generation later:
  // executive summary, requirements program, scope suggestion, briefing checklist
  meetingStatus  MeetingStatus @default(NOT_SCHEDULED)
  meetingType    MeetingType?
  meetingDate    DateTime?
  meetingSummary String? // long text — AI input source

  // Categoria B soft-delete (archive) — deliberately independent of `status`.
  // `status: INACTIVE` is a user-selectable CRM pipeline state (exposed in
  // ClientForm and the client list's "Inativos" tab) and must never be
  // conflated with "this record was archived via the delete button" — doing
  // so would make a manually-INACTIVE client indistinguishable from an
  // archived one, and restoring an archived client would wrongly leave it
  // looking like a normal INACTIVE pipeline client.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id])
  opportunities   Opportunity[]
  proposals       Proposal[]
  projects        Project[]
  meetings        Meeting[]
  documents       Document[]
  documentFolders DocumentFolder[]

  financialDocuments FinancialDocument[]
  timeEntries        TimeEntry[]

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, name])
  @@index([userId, status])
  @@index([workspaceId, archived])
  @@map("clients")
}

model Opportunity {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  clientId String @db.ObjectId

  title            String
  projectType      String
  city             String?
  state            String?
  squareMeters     Float?
  estimatedBudget  Float?
  estimatedRevenue Float?
  probability      Float            @default(10)
  stage            OpportunityStage @default(LEAD)
  source           String?

  // Categoria B soft-delete (archive) — never physically deleted.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  briefing  Briefing?
  proposals Proposal[]
  followUps FollowUp[]
  projects  Project[] // app-enforced "at most one" — see Project.opportunityId comment

  @@index([userId, stage])
  @@index([workspaceId, stage])
  @@index([userId, clientId])
  @@index([userId, createdAt])
  @@index([workspaceId, archived])
  @@map("opportunities")
}

model Briefing {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  opportunityId String @unique @db.ObjectId

  projectObjective String?
  spaceUsage       String?
  desiredStyle     String?
  currentProblems  String?
  priorities       String?
  budget           String?
  timeline         String?
  meetingNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("briefings")
}

model FollowUp {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  // Direct workspace scoping — needed now that a FollowUp can exist without an
  // Opportunity (projectId/clientId-only links have no relation to scope through).
  // Optional to match the same nullable-workspaceId convention used by every
  // other domain model here (Opportunity, Proposal, Project, Client, Meeting);
  // backfilled for existing rows via scripts/backfill-followup-workspace.ts.
  workspaceId   String? @db.ObjectId
  opportunityId String? @db.ObjectId
  userId        String  @db.ObjectId

  // Alternate links for follow-ups not tied to an Opportunity (e.g. automation
  // 07/10 below) — same plain-scalar pattern as Meeting.projectId/proposalId,
  // no @relation wired on purpose (Mongo + Prisma, no enforced referential integrity).
  projectId String? @db.ObjectId
  clientId  String? @db.ObjectId

  title           String?
  nextContactDate DateTime
  notes           String?
  completed       Boolean      @default(false)
  source          RecordSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([opportunityId])
  @@index([projectId])
  @@index([clientId])
  @@index([workspaceId, completed])
  @@index([workspaceId, nextContactDate])
  @@map("follow_ups")
}

// ─── Proposal Domain ──────────────────────────────────────────────────────────

model Proposal {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  // Link to new domain (optional for backward compat)
  opportunityId String? @db.ObjectId
  clientId      String? @db.ObjectId

  // Client & project (kept for standalone proposals)
  clientName   String
  projectType  String
  squareMeters Float
  city         String
  state        String?
  style        String

  // Briefing
  scope            String
  projectObjective String?
  spaceUsage       String?
  currentProblems  String?
  priorities       String?
  budget           String?
  timeline         String?
  meetingNotes     String?

  // Generated content
  generatedText         String?
  generatedProposalJson String?
  proposalVersion       Int     @default(1)
  proposalTone          String?
  architectureStyle     String?

  // Status
  status          ProposalStatus @default(DRAFT)
  statusUpdatedAt DateTime?

  // Pricing
  pricingMethod       PricingMethod?
  hourlyRate          Float?
  estimatedHours      Float?
  pricePerSquareMeter Float?
  complexity          Complexity?
  estimatedTotal      Float?
  regionalAverageMin  Float?
  regionalAverageMax  Float?

  // Proposal Builder — set by ProposalAdvisorService's recommendation when
  // the builder is initialized; "builder" prefix keeps these distinct from
  // the legacy one-shot fields above (generatedProposalJson/proposalTone).
  builderTemplateId       String?               @db.ObjectId
  builderNarrativeProfile String? // NarrativeProfile value, e.g. "CONSULTIVE" — not a ProposalNarrative id, see proposal-advisor types
  builderSkin             ProposalSkin?
  builderStatus           ProposalBuilderStatus @default(DRAFT)

  // Categoria B soft-delete (archive) — never physically deleted.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?                @relation(fields: [workspaceId], references: [id])
  opportunity      Opportunity?              @relation(fields: [opportunityId], references: [id])
  client           Client?                   @relation(fields: [clientId], references: [id])
  projects         Project[] // app-enforced "at most one" — see Project.proposalId comment
  media            ProposalMedia[]
  statusHistory    ProposalStatusHistory[]
  versions         ProposalVersion[]
  sectionInstances ProposalSectionInstance[]

  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([userId, createdAt])
  @@index([opportunityId])
  @@index([clientId])
  @@index([workspaceId, archived])
  @@map("proposals")
}

model ProposalVersion {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String @db.ObjectId

  version          Int
  generatedContent String

  createdAt DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([proposalId, version])
  @@map("proposal_versions")
}

model ProposalMedia {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  proposalId  String    @db.ObjectId
  type        MediaType
  title       String?
  description String?
  url         String
  storagePath String?
  thumbnail   String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([proposalId, order])
  @@map("proposal_media")
}

model DocumentFolder {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  workspaceId String?  @db.ObjectId
  clientId    String?  @db.ObjectId
  projectId   String?  @db.ObjectId
  name        String
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([projectId])
  @@map("document_folders")
}

model Document {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @db.ObjectId
  workspaceId    String?      @db.ObjectId
  clientId       String?      @db.ObjectId
  projectId      String?      @db.ObjectId
  folderId       String?      @db.ObjectId
  name           String
  type           DocumentType
  currentVersion Int          @default(1)

  // Categoria B soft-delete (archive) — never physically deleted.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id])
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    DocumentFolder?   @relation(fields: [folderId], references: [id])
  versions  DocumentVersion[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([projectId])
  @@index([folderId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, archived])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId  String   @db.ObjectId
  userId      String   @db.ObjectId
  version     Int
  fileName    String
  mimeType    String
  size        Int
  url         String
  storagePath String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, version])
  @@map("document_versions")
}

model ProposalStatusHistory {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String         @db.ObjectId
  oldStatus  ProposalStatus
  newStatus  ProposalStatus
  changedAt  DateTime       @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([proposalId, changedAt])
  @@map("proposal_status_history")
}

// ─── Proposal Content Library ────────────────────────────────────────────────
// workspaceId: null rows are the platform-default library every workspace
// falls back to. Workspace rows take precedence over defaults by key/sectionKey
// (resolved in the repository layer, not via a DB constraint).

model ProposalTemplate {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  name         String
  description  String?
  skin         ProposalSkin @default(EDITORIAL)
  sectionOrder String[] // ordered ProposalSection.key refs

  isFavorite        Boolean @default(false)
  isPlatformDefault Boolean @default(false)

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@map("proposal_templates")
}

model ProposalSection {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  key         String // e.g. "executive-summary" — stable reference used by blocks/instances
  name        String
  description String?
  order       Int     @default(0)

  // Fase 2.0 — Etapa 6: true for sections that exist only to receive content
  // migrated from legacy generatedProposalJson proposals (e.g. "Investimento",
  // "Riscos"). Excluded from the AI advisor's recommendations and from the
  // manual "Adicionar seção" picker for new proposals — the legacy migrator
  // is the only caller allowed to use them.
  isMigrationOnly   Boolean @default(false)
  // Proposal Experience v2 (Fase A): true for the 12 fixed premium-narrative
  // catalog rows (premium-cover … premium-closing). Excluded from the advisor
  // and the manual picker like isMigrationOnly, but semantically distinct:
  // these are real, always-all-present flow sections created only by the
  // premium initialize() path, never picked à la carte.
  isPremiumFlowOnly Boolean @default(false)

  // Categoria B soft-delete (Entity Lifecycle, ADR-020) — replaces isArchived.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  // Workspace sections override platform defaults (workspaceId: null) by key.
  // The unique constraint already indexes [workspaceId, key] — a separate
  // @@index on the same columns is redundant and fails schema validation.
  // NOTE: existing duplicate keys must be resolved before running prisma db push.
  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@map("proposal_sections")
}

model ProposalBlock {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  sectionKey   String // ProposalSection.key this block belongs to
  name         String // e.g. "Executive Premium"
  variantLabel String?
  content      String // static starting prose — architect always hand-edits after picking

  toneTags String[]

  // Scoring axes consumed by ProposalAdvisorService's deterministic rules
  // engine (see services/ai/proposal-advisor-scoring.ts) — distinct from
  // toneTags, which drives the AI prose-generation personas instead.
  projectTypeTags      String[] // ProjectTypeCategory values this block fits (e.g. "RESIDENTIAL_PREMIUM")
  investmentTags       String[] // InvestmentTier values this block fits (e.g. "HIGH")
  narrativeProfileTags String[] // NarrativeProfile values this block fits (e.g. "CONSULTIVE")
  keywords             String[] // free-text synonyms matched against briefing/notes signals

  version       Int     @default(1)
  parentBlockId String? @db.ObjectId // previous version in the chain, if any

  isFavorite        Boolean @default(false)
  sharedInWorkspace Boolean @default(true)

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, sectionKey])
  @@index([workspaceId, archived])
  @@map("proposal_blocks")
}

model ProposalNarrative {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  name        String
  description String?
  toneKey     String // maps to the existing 5 tone personas in tone.service.ts
  sectionFlow String[] // recommended ProposalSection.key order

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@map("proposal_narratives")
}

// A per-proposal snapshot, deliberately decoupled from the library — once a
// block is inserted into a proposal, editing or archiving that ProposalBlock
// later must never change a proposal that already snapshotted it. sectionId/
// blockId are plain scalars with no @relation (same pattern as
// FollowUp.projectId/clientId): blockId may point at a platform-default
// block (workspaceId: null), a different "scope" than the instance's own
// workspaceId, so relation enforcement isn't meaningful here on Mongo anyway.
model ProposalSectionInstance {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @db.ObjectId
  proposalId  String @db.ObjectId

  sectionId String  @db.ObjectId // ProposalSection.id this slot represents
  blockId   String? @db.ObjectId // ProposalBlock.id this was snapshotted from — null for fully custom sections

  sortOrder Int
  title     String
  content   String
  metadata  String? // JSON-stringified — see Workspace.dashboardLayout for the same string-not-Json convention

  createdFromLibrary Boolean @default(false)
  isCustomized       Boolean @default(false)
  // Fase B — hidden sections stay in the Builder's structure column
  // (toggleable) but are excluded from the preview, the detail view and
  // the exported PDF. Never deleted: content is preserved.
  isHidden           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([proposalId])
  @@index([proposalId, sortOrder])
  @@index([sectionId])
  @@index([blockId])
  @@map("proposal_section_instances")
}

// ─── Project Domain ───────────────────────────────────────────────────────────

model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  // Relationships
  // NOT @unique: MongoDB's unique index on an optional field is non-sparse —
  // every doc missing the field is indexed as null, so a second project with
  // no proposalId/opportunityId would violate the constraint and crash every
  // manual "create project" after the first. One-project-per-source is
  // enforced at the application layer instead (see projectRepository.findByOpportunityId
  // and the pre-create check in opportunity.service.ts).
  clientId      String  @db.ObjectId
  proposalId    String? @db.ObjectId // one proposal → at most one project (app-enforced)
  opportunityId String? @db.ObjectId // one opportunity → at most one auto-created project (Automação 01 idempotency guard, app-enforced)

  // Identity
  name        String
  code        String?
  description String?

  // Classification
  type   ProjectType
  status ProjectStatus @default(BRIEFING)
  phase  ProjectPhase  @default(BRIEFING) // AEC pipeline phase for the Kanban board — independent from `status`

  // Scope
  squareMeters Float?
  address      String?
  city         String?
  state        String?

  // Timeline
  startDate        DateTime?
  estimatedEndDate DateTime?
  actualEndDate    DateTime?

  // Financial
  contractValue Float?

  // Internal
  notes String?

  // Categoria B soft-delete (archive) — never physically deleted.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal        Proposal?        @relation(fields: [proposalId], references: [id])
  opportunity     Opportunity?     @relation(fields: [opportunityId], references: [id])
  documents       Document[]
  documentFolders DocumentFolder[]
  tasks           Task[]

  financialDocuments FinancialDocument[]
  purchaseOrders     PurchaseOrder[]
  timeEntries        TimeEntry[]

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, status])
  @@index([userId, clientId])
  @@index([userId, createdAt])
  @@index([workspaceId, phase])
  @@index([workspaceId, estimatedEndDate])
  @@index([proposalId])
  @@index([opportunityId])
  @@index([workspaceId, archived])
  @@map("projects")
}

// ─── Meeting Domain ───────────────────────────────────────────────────────────

model Meeting {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId
  clientId    String  @db.ObjectId

  // Core
  title  String
  type   MeetingPurpose
  status MeetingEntryStatus @default(SCHEDULED)

  // Schedule
  scheduledAt DateTime
  duration    Int? // minutes

  // Location
  location String?

  // Structured notes
  objectives String?
  notes      String?
  decisions  String?
  nextSteps  String?

  // Legacy free-form summary
  summary String?

  // Future — project / proposal linking
  projectId  String? @db.ObjectId
  proposalId String? @db.ObjectId

  // Future — Google Workspace
  googleCalendarEventId String?
  meetUrl               String?

  // Future — Integrated AI
  aiSummary String?

  // Categoria B soft-delete (archive) — never physically deleted.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, clientId])
  @@index([clientId])
  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@index([projectId])
  @@index([proposalId])
  @@index([workspaceId, archived])
  @@map("meetings")
}

// ─── Automation Domain ────────────────────────────────────────────────────────
// Fixed, hardcoded business-rule automations (Fase 5) — no AI/LLM involved.
// `Automation` is the per-workspace on/off toggle + display row; `AutomationRun`
// is the execution log that feeds the dashboard widget and the "Última
// Execução"/"Executada Hoje" columns on the Automações screen.

model Automation {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String        @db.ObjectId
  key         AutomationKey
  name        String
  description String
  trigger     String
  enabled     Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("automations")
}

model AutomationRun {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String               @db.ObjectId
  key         AutomationKey
  resultType  AutomationResultType
  entityType  String
  entityId    String
  message     String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, key, createdAt])
  @@index([workspaceId, createdAt])
  @@map("automation_runs")
}

model Task {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String         @db.ObjectId
  projectId     String         @db.ObjectId
  assigneeId    String         @db.ObjectId
  title         String
  status        TaskStatus     @default(PENDING)
  source        RecordSource   @default(AUTOMATION)
  // Which per-phase automation (Automações 02-05) created this task, if any —
  // lets onPhaseChanged() check "was this phase's task already created for this
  // project?" before inserting, instead of relying on title string matching.
  automationKey AutomationKey?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User      @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  timeEntries TimeEntry[]

  @@index([workspaceId, projectId])
  @@index([workspaceId, projectId, automationKey])
  @@index([assigneeId, status])
  @@map("tasks")
}

// ─── Financial Domain ─────────────────────────────────────────────────────────
// Office-level bookkeeping: the workspace's own suppliers, clients billing,
// and cash. Ledger shape is Título → Parcela → Baixa (FinancialDocument →
// Installment → Payment) so partial/multiple payments per installment are
// representable — a flat "contas a pagar" row with one paidAt could not do
// that. Payment rows are append-only (no update/delete route is ever wired);
// reversal is a deliberately deferred v2 (compensating entry, not a mutation).

model SupplierCategory {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @db.ObjectId

  name       String

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  suppliers Supplier[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@map("supplier_categories")
}

model Supplier {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String  @db.ObjectId
  categoryId  String? @db.ObjectId

  name     String
  document String? // CPF/CNPJ, free text — no format enforced at the DB layer
  email    String?
  whatsapp String?
  phone    String?
  website  String?
  address  String?
  notes    String?

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category           SupplierCategory?   @relation(fields: [categoryId], references: [id])
  financialDocuments FinancialDocument[]
  purchaseOrders     PurchaseOrder[]

  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@index([categoryId])
  @@map("suppliers")
}

model BankAccount {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @db.ObjectId

  name                String
  bankName            String
  agency              String?
  accountNumber       String?
  type                BankAccountType @default(CHECKING)
  // Current balance is intentionally NOT stored — it would drift from the
  // Payment ledger. Always derive: initialBalanceCents + net(payments).
  // BigInt (BSON Int64), not Int (BSON Int32, caps at ~R$21.4M) — see
  // RC-2.2 in docs/financial-architecture.md for why every money field in
  // this domain uses BigInt.
  initialBalanceCents BigInt          @default(0)

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@map("bank_accounts")
}

// Self-referencing tree (plano de contas). direction is fixed per branch so a
// Despesas category can never be picked for a RECEIVABLE document — enforced
// in the service layer at write time (Mongo has no CHECK constraints).
model FinancialCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String  @db.ObjectId
  parentId    String? @db.ObjectId

  name       String
  direction  FinancialDirection

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Self-relations on the Mongo connector must disable referential actions —
  // there is no FK to cascade against, and Prisma requires this explicit for
  // self-relations rather than inferring a default.
  parent         FinancialCategory?  @relation("FinancialCategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       FinancialCategory[] @relation("FinancialCategoryTree")
  documents      FinancialDocument[]
  purchaseOrders PurchaseOrder[]

  @@index([workspaceId])
  @@index([workspaceId, direction])
  @@index([parentId])
  @@index([workspaceId, archived])
  @@map("financial_categories")
}

model CostCenter {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @db.ObjectId

  name       String

  // Categoria B soft-delete (Entity Lifecycle, ADR-020).
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents      FinancialDocument[]
  purchaseOrders PurchaseOrder[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@map("cost_centers")
}

// The "título" — projectId/clientId/supplierId are all optional so overhead
// expenses (rent, payroll, software) can exist with no project, matching how
// Document/FollowUp already use optional dual linkage elsewhere in this
// schema. Direction constrains which of clientId/supplierId is valid — the
// service layer enforces PAYABLE⇒no clientId, RECEIVABLE⇒no supplierId.
model FinancialDocument {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @db.ObjectId

  direction FinancialDirection

  projectId    String? @db.ObjectId
  clientId     String? @db.ObjectId
  supplierId   String? @db.ObjectId
  categoryId   String  @db.ObjectId
  costCenterId String? @db.ObjectId

  description      String
  competencyDate   DateTime
  // Cache of sum(installments.amountCents), validated against the actual
  // installments at creation time in the service layer — read-path
  // convenience only, installments remain the source of truth. BigInt, see
  // BankAccount.initialBalanceCents comment.
  totalAmountCents BigInt
  notes            String?
  // Soft-cancel only — same append-only spirit as Payment, one level up.
  // finance.delete maps to this, never a physical delete.
  isCancelled      Boolean  @default(false)
  // RC-3.1 — optimistic-concurrency counter, bumped by every write that must
  // not silently race against a cancellation: registerPayment's guard-write
  // and cancelIfNoPayments's own cancel-write both increment it. Its value
  // is never read by application logic; its only job is to make both writers
  // genuinely mutate this same document, which is what gives Mongo's
  // multi-document transaction engine something real to detect a
  // write-write conflict on. See installment.repository.ts#registerPayment
  // for the full race-condition writeup this closes.
  version          Int      @default(0)

  createdByUserId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id])
  client       Client?           @relation(fields: [clientId], references: [id])
  supplier     Supplier?         @relation(fields: [supplierId], references: [id])
  category     FinancialCategory @relation(fields: [categoryId], references: [id])
  costCenter   CostCenter?       @relation(fields: [costCenterId], references: [id])
  createdBy    User              @relation(fields: [createdByUserId], references: [id])
  installments Installment[]

  @@index([workspaceId, direction])
  @@index([workspaceId, projectId])
  @@index([workspaceId, supplierId])
  @@index([workspaceId, clientId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, competencyDate])
  @@map("financial_documents")
}

model Installment {
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId         String @db.ObjectId
  financialDocumentId String @db.ObjectId

  number      Int // 1-based
  amountCents BigInt // see BankAccount.initialBalanceCents comment
  dueDate     DateTime
  status      InstallmentStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialDocument FinancialDocument @relation(fields: [financialDocumentId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([financialDocumentId])
  @@map("installments")
}

// The "baixa" — append-only by design (see file-level note above). Every
// write that creates a Payment must also transition its Installment.status
// (OPEN/PARTIAL/PAID) inside the same $transaction, since Mongo enforces no
// referential integrity between the sum of payments and the installment.
model Payment {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String @db.ObjectId
  installmentId String @db.ObjectId
  bankAccountId String @db.ObjectId

  // RC-2.1 — idempotency. Every payment write must supply this (client-
  // generated UUID, stable across retries of the same intent — see
  // installment.repository.ts#registerPayment). The @unique index is the
  // actual enforcement: a second insert attempt with the same key fails at
  // the DB layer and the service catches that to return the original
  // payment instead of erroring, which is race-safe under real concurrency
  // in a way a "check then insert" read never is.
  idempotencyKey String @unique

  // RC-2.5 — denormalized from FinancialDocument.direction at creation time
  // (via the Installment it's posted against) so dashboard/report
  // aggregates can filter Payment directly instead of a 2-hop $lookup
  // through Installment→FinancialDocument. Safe to denormalize: direction
  // is immutable after a FinancialDocument is created (see that model's
  // validation comment) and Payment rows are never edited, so this can
  // never drift from its source once written.
  direction FinancialDirection

  // RC-3.3 — denormalized the same way and for the same safety reason as
  // `direction` above (FinancialDocument.projectId is also immutable post-
  // creation, per updateFinancialDocumentSchema). Measured, not guessed:
  // scripts/rc3-perf-check.ts (see docs/financial-architecture.md §6) showed
  // projectFinancialSummaryService's Payment aggregate going from ~30s to
  // ~140ms at just 100k payments once this replaced the
  // installment.financialDocument.projectId $lookup — a 200x+ difference at
  // a workspace size that isn't even unusual, not a marginal optimization.
  // Null for payments against documents with no project (overhead expenses).
  projectId String? @db.ObjectId

  amountCents BigInt // see BankAccount.initialBalanceCents comment
  paidAt      DateTime
  method      PaymentMethod

  createdByUserId String @db.ObjectId

  createdAt DateTime @default(now()) // no updatedAt on purpose — rows are never edited

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  createdBy   User        @relation(fields: [createdByUserId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, direction])
  @@index([workspaceId, direction, paidAt])
  // RC-3.3 — backs projectFinancialSummaryService's per-project aggregates directly.
  @@index([workspaceId, projectId, direction])
  @@index([installmentId])
  @@index([bankAccountId])
  @@map("payments")
}

// ─── Compras (Purchasing) ──────────────────────────────────────────────────────
// Fase 1 (Fundação) — docs/COMPRAS_ARCHITECTURE_DECISIONS.md. Depends on Finance
// (Supplier, FinancialCategory, CostCenter) in one direction only — Finance
// never references PurchaseOrder (DOMAIN_GUIDE.md §6).

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model PurchaseOrder {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @db.ObjectId

  supplierId   String  @db.ObjectId
  projectId    String? @db.ObjectId
  categoryId   String  @db.ObjectId // service validates category.direction === PAYABLE
  costCenterId String? @db.ObjectId

  description String
  dueDate     DateTime // Date-Only (ADR-005) — becomes the single Installment's dueDate on approve()
  notes       String?

  status PurchaseOrderStatus @default(DRAFT)

  // Server-computed sum of items.totalCents, never trusted from the client —
  // same invariant as FinancialDocument.totalAmountCents.
  totalAmountCents BigInt

  // One-directional link, set only on approve() — FinancialDocument never
  // references back to PurchaseOrder (ADR-016/ARCHITECTURE_ROADMAP.md §1).
  // NOT @unique here — same reason as User.supabaseId/Subscription.
  // mpSubscriptionId (docs/indexes.md): Prisma's @unique on Mongo is never
  // sparse, so every DRAFT order (financialDocumentId: null) would collide
  // against every other DRAFT order on the same null value. Caught for real
  // by scripts/rc-compras-approve-check.ts's second concurrent DRAFT order,
  // not by any mocked test. Uniqueness-once-approved is enforced by a
  // manually-created sparse unique index (docs/indexes.md).
  financialDocumentId String? @db.ObjectId

  // ADR-017 — client-generated, checked as the first statement inside the
  // create() transaction on every attempt (including retries), same pattern
  // as Payment.idempotencyKey.
  idempotencyKey String @unique

  // ADR-017 — optimistic-concurrency counter bumped by the CAS updateMany in
  // approve()/cancel(). Its value is never read by application logic; its
  // only job is to give approve()-vs-approve()/cancel() something real to
  // race over via the status precondition in the same updateMany.
  version Int @default(0)

  createdByUserId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  project    Project?            @relation(fields: [projectId], references: [id])
  category   FinancialCategory   @relation(fields: [categoryId], references: [id])
  costCenter CostCenter?         @relation(fields: [costCenterId], references: [id])
  createdBy  User                @relation(fields: [createdByUserId], references: [id])
  items      PurchaseOrderItem[]

  @@index([workspaceId, status])
  @@index([workspaceId, supplierId])
  @@index([workspaceId, projectId])
  @@map("purchase_orders")
}

// Own collection, not a Prisma composite/embedded type — mirrors
// Installment's shape exactly (ADR-016). Always created together with its
// parent inside the same transaction; never queried independently of a
// PurchaseOrder.
model PurchaseOrderItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String @db.ObjectId
  purchaseOrderId String @db.ObjectId

  description String
  quantity    Float // not money — can be fractional (e.g. m³ of material)
  unitCents   BigInt
  totalCents  BigInt // = round(quantity * unitCents), computed server-side

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([workspaceId, purchaseOrderId])
  @@map("purchase_order_items")
}

// ─── Billing ──────────────────────────────────────────────────────────────────
// Phase 1 of the billing foundation: data model only, no payment gateway wired
// up yet. Workspace.plan remains the field every existing read path already
// uses (feature gates, limits) — Subscription is the new authoritative
// lifecycle record that the eventual Mercado Pago integration will drive.
// They're kept in sync by subscription.service.ts, not by a DB constraint.

model Subscription {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @unique @db.ObjectId

  plan         Plan
  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)

  // Mercado Pago references — populated once Phase 2 wires up the gateway.
  // No @unique here on purpose: Prisma's @unique on MongoDB is never sparse,
  // so it would reject a second null long before any real value collides.
  // Uniqueness for mpSubscriptionId is enforced only by the manually-created
  // sparse index documented in docs/indexes.md (same pattern as User.supabaseId).
  mpCustomerId     String?
  mpSubscriptionId String?

  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    PaymentEvent[]
  invoices  BillingHistory[]

  @@map("subscriptions")
}

model PaymentEvent {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String @db.ObjectId

  provider    String // "mercadopago" — kept as a free string so a second provider never needs a schema change
  externalId  String // the gateway's own event id — the idempotency key for webhook processing
  type        String // e.g. "payment.created", "subscription.updated"
  rawPayload  String // full JSON of the received webhook body, for audit/replay
  processedAt DateTime?
  status      String    @default("received") // received | processed | failed

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([externalId])
  @@index([subscriptionId])
  @@map("payment_events")
}

model BillingHistory {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String @db.ObjectId

  amount      Float
  currency    String    @default("BRL")
  status      String // paid | failed | refunded
  // No @unique here either — same reasoning as Subscription.mpSubscriptionId.
  // Uniqueness comes only from the sparse index in docs/indexes.md.
  mpPaymentId String?
  paidAt      DateTime?
  description String

  // Sprint 09 — completes the brief's "Payment" entity: the gateway receipt
  // link surfaced in the financial-history UI, and the full payment payload
  // kept for audit/reconciliation (same string-JSON convention as
  // PaymentEvent.rawPayload).
  receiptUrl String?
  rawPayload String?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("billing_history")
}

// Sprint 09 — persisted, sellable plan definition: the canonical source for
// pricing and display (Story 3 — "planos não podem ficar hardcoded"). The
// enforcement limits still live in config/plans.ts (PLAN_LIMITS, the hot path);
// this table is SEEDED from it (prisma/seed-billing-plans.ts) so the two never
// diverge, while adding the pricing + Mercado Pago plan mapping the code config
// never held. Keyed by the Plan enum so a Workspace.plan resolves directly to
// its sellable definition.
model BillingPlan {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         Plan    @unique
  name        String
  description String?

  priceMonthly Float
  priceAnnual  Float

  // Mirrored from config/plans.ts for display only (-1 = unlimited). Never read
  // by the enforcement path — see the model comment above.
  limitProjects  Int
  limitUsers     Int
  limitAiMonthly Int
  limitUploadsMb Int

  active Boolean @default(true)
  order  Int     @default(0)

  // Mercado Pago preapproval_plan ids per cycle — populated once the plans are
  // created in the MP dashboard. No @unique (Prisma @unique on Mongo is never
  // sparse); uniqueness enforced by the sparse index in docs/indexes.md.
  mpPreapprovalPlanIdMonthly String?
  mpPreapprovalPlanIdAnnual  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("billing_plans")
}

// ─── Location & Pricing ───────────────────────────────────────────────────────

model State {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  uf     String @unique
  cities City[]

  @@map("states")
}

model City {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  ibgeCode       Int    @unique
  name           String
  nameNormalized String
  stateUf        String
  stateId        String @db.ObjectId
  state          State  @relation(fields: [stateId], references: [id])

  @@index([nameNormalized])
  @@index([stateUf])
  @@index([stateUf, nameNormalized])
  @@map("cities")
}

model RegionalPricing {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  stateUf       String
  city          String?
  projectType   String
  pricingMethod PricingMethod
  minValue      Float
  maxValue      Float
  averageValue  Float
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([stateUf])
  @@index([stateUf, projectType])
  @@index([stateUf, pricingMethod])
  @@index([stateUf, city, projectType, pricingMethod])
  @@map("regional_pricing")
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model ResetPasswordToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("reset_password_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique // sha256(jti) — never store raw jti
  jti       String    @unique // UUID embedded in the signed JWT
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

// ─── User Preferences ────────────────────────────────────────────────────────

model UserPreferences {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  preferredLanguage String   @default("pt")
  preferredTheme    String   @default("dark")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_preferences")
}

// ─── System ───────────────────────────────────────────────────────────────────

model Instance {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  status      InstanceStatus @default(PENDING)
  ip          String
  environment Environment    @default(PRODUCTION)
  memoryUsage Float          @default(0)
  cpuUsage    Float          @default(0)
  uptime      Int            @default(0)
  createdAt   DateTime       @default(now())

  @@map("instances")
}

// ─── Worklog ────────────────────────────────────────────────────────────────
// Fase 1 (Fundação) — docs/WORKLOG_ARCHITECTURE_DECISIONS.md. Depends on
// Projetos/Clientes/Tasks in one direction only, read-only reference
// (DOMAIN_GUIDE.md §6/§1) — not a Core module in this phase (ADR-023).

enum TimeEntryStatus {
  RUNNING
  PAUSED
  COMPLETED
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

model ActivityCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId

  name      String
  isDefault Boolean @default(false) // seeded default categories (prisma/seed.ts), workspace can still archive them

  // Categoria B soft-delete (ADR-020) — delegated entirely to entityLifecycleService.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([workspaceId, archived])
  @@map("activity_categories")
}

model TimeEntry {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String @db.ObjectId
  userId      String @db.ObjectId

  projectId  String? @db.ObjectId
  clientId   String? @db.ObjectId
  taskId     String? @db.ObjectId
  categoryId String? @db.ObjectId

  description String?
  tags        String[]

  status     TimeEntryStatus  @default(COMPLETED)
  source     TimeEntrySource  @default(MANUAL)
  isBillable Boolean          @default(true)

  // Immutable — the original moment the timer/manual entry began, used for
  // display ("iniciado às...") and reporting. Never overwritten by
  // pause()/resume(), unlike lastResumedAt below.
  startedAt DateTime
  endedAt   DateTime?

  // Start of the CURRENT running span — reset on every resume(). Only
  // meaningful while status === RUNNING; null while PAUSED/COMPLETED.
  // Separate from startedAt so the original start time survives any number
  // of pause/resume cycles for display purposes.
  lastResumedAt DateTime?

  // Seconds accumulated across previous RUNNING spans, before the current
  // pause (or before stop() folds the final span in) — never the total by
  // itself; stop() always computes durationSeconds server-side from this
  // plus the final RUNNING span (now - lastResumedAt), never trusts a
  // client-submitted duration.
  pausedAccumSec  Int  @default(0)
  durationSeconds Int? // set once, by stop() — immutable after that (manual entries set it at creation)

  // ADR-021 — set to `userId` only while status is RUNNING/PAUSED, cleared to
  // null on stop(). Deliberately NOT @unique here: Prisma's @unique on Mongo
  // is not sparse (docs/indexes.md), so every COMPLETED/archived TimeEntry
  // sharing `null` would collide. The real one-active-timer-per-user
  // constraint is a manually-created sparse unique index — see
  // docs/indexes.md, "Worklog — time_entries.activeOwnerId Sparse Unique
  // Index". Must exist in every environment before the first real start().
  activeOwnerId String? @db.ObjectId

  // Categoria B soft-delete (ADR-020) — delegated entirely to entityLifecycleService.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?          @relation(fields: [projectId], references: [id])
  client    Client?           @relation(fields: [clientId], references: [id])
  task      Task?             @relation(fields: [taskId], references: [id])
  category  ActivityCategory? @relation(fields: [categoryId], references: [id])

  @@index([workspaceId, userId, archived])
  @@index([workspaceId, projectId])
  @@map("time_entries")
}
