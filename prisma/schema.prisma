generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Plan {
  STARTER
  PROFESSIONAL
  STUDIO
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  ARCHITECT
  DESIGNER
  ASSISTANT
  VIEWER
}

enum ProposalStatus {
  DRAFT
  REVIEW
  SENT
  NEGOTIATION
  APPROVED
  REJECTED
}

enum ClientStatus {
  LEAD
  NEGOTIATION
  ACTIVE
  INACTIVE
}

enum MeetingStatus {
  NOT_SCHEDULED
  SCHEDULED
  COMPLETED
}

enum MeetingType {
  IN_PERSON
  PHONE_CALL
  GOOGLE_MEET
}

enum OpportunityStage {
  LEAD
  BRIEFING
  PROPOSAL_DRAFT
  PROPOSAL_SENT
  NEGOTIATION
  APPROVED
  LOST
}

enum PricingMethod {
  HOURLY
  SQUARE_METER
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
  PREMIUM
}

enum WorkspaceType {
  INDIVIDUAL
  SMALL_OFFICE
  GROWING_OFFICE
  LARGE_OFFICE
}

enum TeamSize {
  SOLO
  TWO_TO_FIVE
  FIVE_TO_FIFTEEN
  FIFTEEN_PLUS
}

enum PrimaryGoal {
  PROPOSAL_GENERATION
  CLIENT_PRESENTATION
  BRIEFING_ORGANIZATION
  PRICING_WORKFLOW
  VISUAL_REFERENCES
}

enum MediaType {
  IMAGE
  GIF
  VIDEO
  YOUTUBE
  VIMEO
}

enum ProjectStatus {
  BRIEFING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum MeetingEntryStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingPurpose {
  INITIAL_CONTACT
  DISCOVERY
  BRIEFING
  PROPOSAL_REVIEW
  FOLLOW_UP
  OTHER
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
  INTERIOR
  URBAN
  LANDSCAPE
}

enum InstanceStatus {
  RUNNING
  STOPPED
  PENDING
  ERROR
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

// ─── Core Domain Models ───────────────────────────────────────────────────────

model Workspace {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String  @unique
  plan      Plan    @default(STARTER)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  invites       WorkspaceInvite[]
  clients       Client[]
  opportunities Opportunity[]
  proposals     Proposal[]
  projects      Project[]
  meetings      Meeting[]
  branding      OfficeBranding?

  @@map("workspaces")
}

model WorkspaceInvite {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String        @db.ObjectId
  email       String
  role        WorkspaceRole @default(ARCHITECT)
  token       String        @unique
  expiresAt   DateTime
  accepted    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invites")
}

model User {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  supabaseId String?  // Supabase auth.users UUID — null for pre-migration users
                      // IMPORTANT: uniqueness enforced by a MongoDB sparse index (see docs/indexes.md)
                      // Prisma's @unique creates a non-sparse index that rejects multiple nulls.
  name      String
  email     String    @unique
  password  String?   // Transitional: kept during Phase 1 for NextAuth credentials; removed in Phase 2
  image     String?
  provider  String    @default("credentials")
  googleId  String?
  role          Role          @default(USER)
  workspaceId   String?       @db.ObjectId
  workspaceRole WorkspaceRole @default(OWNER)
  lastLogin     DateTime?

  // Onboarding
  workspaceType       WorkspaceType?
  teamSize            TeamSize?
  primaryGoal         PrimaryGoal?
  onboardingCompleted Boolean        @default(false)
  onboardingStep      Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals     Proposal[]
  clients       Client[]
  opportunities Opportunity[]
  projects      Project[]
  meetings      Meeting[]
  followUps     FollowUp[]
  branding      OfficeBranding?
  workspace     Workspace?      @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("users")
}

model OfficeBranding {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @unique @db.ObjectId
  workspaceId String? @unique @db.ObjectId

  // Office identity
  officeName    String?
  tradeName     String?
  architectName String?
  cauNumber     String?

  // Contact
  email     String?
  phone     String?
  whatsapp  String?
  website   String?
  instagram String?

  // Brand colors (hex)
  primaryColor   String?
  secondaryColor String?

  // Assets — URLs (public or signed) + storage paths for refresh
  logoUrl              String?
  logoStoragePath      String?
  logoWhiteUrl         String?
  logoWhiteStoragePath String?
  faviconUrl           String?
  faviconStoragePath   String?

  // Proposal customization
  proposalSignature String?
  proposalFooter    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@map("office_branding")
}

model Client {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  userId      String @db.ObjectId
  workspaceId String? @db.ObjectId

  // Basic information
  name    String
  email   String?
  phone   String?
  company String?
  address String?
  city    String?
  state   String?
  notes   String?

  // Pipeline status
  status ClientStatus @default(LEAD)

  // First contact — meeting information
  // meetingSummary is designed to feed AI generation later:
  // executive summary, requirements program, scope suggestion, briefing checklist
  meetingStatus  MeetingStatus @default(NOT_SCHEDULED)
  meetingType    MeetingType?
  meetingDate    DateTime?
  meetingSummary String?        // long text — AI input source

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?    @relation(fields: [workspaceId], references: [id])
  opportunities Opportunity[]
  proposals     Proposal[]
  projects      Project[]
  meetings      Meeting[]

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, name])
  @@index([userId, status])
  @@map("clients")
}

model Opportunity {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  clientId String @db.ObjectId

  title            String
  projectType      String
  city             String?
  state            String?
  squareMeters     Float?
  estimatedBudget  Float?
  estimatedRevenue Float?
  probability      Float            @default(10)
  stage            OpportunityStage @default(LEAD)
  source           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  briefing  Briefing?
  proposals Proposal[]
  followUps FollowUp[]

  @@index([userId, stage])
  @@index([workspaceId, stage])
  @@index([userId, clientId])
  @@index([userId, createdAt])
  @@map("opportunities")
}

model Briefing {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  opportunityId String @unique @db.ObjectId

  projectObjective String?
  spaceUsage       String?
  desiredStyle     String?
  currentProblems  String?
  priorities       String?
  budget           String?
  timeline         String?
  meetingNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("briefings")
}

model FollowUp {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  opportunityId String @db.ObjectId
  userId        String @db.ObjectId

  nextContactDate DateTime
  notes           String?
  completed       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([userId, completed])
  @@index([userId, nextContactDate])
  @@map("follow_ups")
}

// ─── Proposal Domain ──────────────────────────────────────────────────────────

model Proposal {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  // Link to new domain (optional for backward compat)
  opportunityId String? @db.ObjectId
  clientId      String? @db.ObjectId

  // Client & project (kept for standalone proposals)
  clientName   String
  projectType  String
  squareMeters Float
  city         String
  state        String?
  style        String

  // Briefing
  scope            String
  projectObjective String?
  spaceUsage       String?
  currentProblems  String?
  priorities       String?
  budget           String?
  timeline         String?
  meetingNotes     String?

  // Generated content
  generatedText         String?
  generatedProposalJson String?
  proposalVersion       Int     @default(1)
  proposalTone          String?
  architectureStyle     String?

  // Status
  status          ProposalStatus @default(DRAFT)
  statusUpdatedAt DateTime?

  // Pricing
  pricingMethod       PricingMethod?
  hourlyRate          Float?
  estimatedHours      Float?
  pricePerSquareMeter Float?
  complexity          Complexity?
  estimatedTotal      Float?
  regionalAverageMin  Float?
  regionalAverageMax  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?              @relation(fields: [workspaceId], references: [id])
  opportunity   Opportunity?            @relation(fields: [opportunityId], references: [id])
  client        Client?                 @relation(fields: [clientId], references: [id])
  project       Project?
  media         ProposalMedia[]
  statusHistory ProposalStatusHistory[]
  versions      ProposalVersion[]

  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([userId, createdAt])
  @@index([opportunityId])
  @@map("proposals")
}

model ProposalVersion {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String @db.ObjectId

  version          Int
  generatedContent String

  createdAt DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([proposalId, version])
  @@map("proposal_versions")
}

model ProposalMedia {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  proposalId  String    @db.ObjectId
  type        MediaType
  title       String?
  description String?
  url         String
  storagePath String?
  thumbnail   String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([proposalId, order])
  @@map("proposal_media")
}

model ProposalStatusHistory {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String         @db.ObjectId
  oldStatus  ProposalStatus
  newStatus  ProposalStatus
  changedAt  DateTime       @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([proposalId, changedAt])
  @@map("proposal_status_history")
}

// ─── Project Domain ───────────────────────────────────────────────────────────

model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId

  // Relationships
  clientId   String  @db.ObjectId
  proposalId String? @unique @db.ObjectId  // one proposal → at most one project

  // Identity
  name        String
  code        String?
  description String?

  // Classification
  type   ProjectType
  status ProjectStatus @default(BRIEFING)

  // Scope
  squareMeters Float?
  address      String?
  city         String?
  state        String?

  // Timeline
  startDate        DateTime?
  estimatedEndDate DateTime?
  actualEndDate    DateTime?

  // Financial
  contractValue Float?

  // Internal
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal  Proposal?  @relation(fields: [proposalId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, status])
  @@index([userId, clientId])
  @@index([userId, createdAt])
  @@map("projects")
}

// ─── Meeting Domain ───────────────────────────────────────────────────────────

model Meeting {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  workspaceId String? @db.ObjectId
  clientId    String  @db.ObjectId

  // Core
  title   String
  type    MeetingPurpose
  status  MeetingEntryStatus @default(SCHEDULED)

  // Schedule
  scheduledAt DateTime
  duration    Int?      // minutes

  // Location
  location String?

  // Structured notes
  objectives String?
  notes      String?
  decisions  String?
  nextSteps  String?

  // Legacy free-form summary
  summary String?

  // Future — project / proposal linking
  projectId  String? @db.ObjectId
  proposalId String? @db.ObjectId

  // Future — Google Workspace
  googleCalendarEventId String?
  meetUrl               String?

  // Future — Integrated AI
  aiSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, clientId])
  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@map("meetings")
}

// ─── Location & Pricing ───────────────────────────────────────────────────────

model State {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  uf     String @unique
  cities City[]

  @@map("states")
}

model City {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  ibgeCode       Int    @unique
  name           String
  nameNormalized String
  stateUf        String
  stateId        String @db.ObjectId
  state          State  @relation(fields: [stateId], references: [id])

  @@index([nameNormalized])
  @@index([stateUf])
  @@index([stateUf, nameNormalized])
  @@map("cities")
}

model RegionalPricing {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  stateUf       String
  city          String?
  projectType   String
  pricingMethod PricingMethod
  minValue      Float
  maxValue      Float
  averageValue  Float
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([stateUf])
  @@index([stateUf, projectType])
  @@index([stateUf, pricingMethod])
  @@index([stateUf, city, projectType, pricingMethod])
  @@map("regional_pricing")
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model ResetPasswordToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("reset_password_tokens")
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique  // sha256(jti) — never store raw jti
  jti       String    @unique  // UUID embedded in the signed JWT
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

// ─── User Preferences ────────────────────────────────────────────────────────

model UserPreferences {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  preferredLanguage String   @default("pt")
  preferredTheme    String   @default("modern-premium")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_preferences")
}

// ─── System ───────────────────────────────────────────────────────────────────

model Instance {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  status      InstanceStatus @default(PENDING)
  ip          String
  environment Environment    @default(PRODUCTION)
  memoryUsage Float          @default(0)
  cpuUsage    Float          @default(0)
  uptime      Int            @default(0)
  createdAt   DateTime       @default(now())

  @@map("instances")
}
